YADISK_CLIENT_ID=replace_with_yandex_client_id
YADISK_CLIENT_SECRET=replace_with_yandex_client_secret
YADISK_REFRESH_TOKEN=
YADISK_REDIRECT_URI=http://replace_with_server_host:17654/oauth/yandex/callback
YADISK_OAUTH_LISTEN_ADDR=:17654
YADISK_FOLDER=disk:/Gemini
POLL_INTERVAL=60
PLACEHOLDER_STALE_AFTER=300
HTTP_TIMEOUT=120
LOG_LEVEL=info
