YADISK_CLIENT_ID=replace_with_yandex_client_id
YADISK_CLIENT_SECRET=replace_with_yandex_client_secret
YADISK_REFRESH_TOKEN=
YADISK_REDIRECT_URI=https://oauth.yandex.ru/verification_code
YADISK_FOLDER=disk:/Gemini

OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
TRANSCRIPTION_PROMPT_FILE=transcription.prompt.txt

POLL_INTERVAL=60
PLACEHOLDER_STALE_AFTER=300
HTTP_TIMEOUT=120
LOG_LEVEL=info
